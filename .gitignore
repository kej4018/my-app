# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 삭제 대기 중인 임시 파일 (검토 후 직접 삭제)
/trash-can

# OCR(tesseract.js)이 실행 중 내려받는 언어 모델 파일 (용량이 커 저장소에 올리지 않는다)
*.traineddata

# bkit 플러그인 로컬 상태 (프로젝트 산출물이 아님)
/.bkit

# typescript
*.tsbuildinfo
next-env.d.ts
